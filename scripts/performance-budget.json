{
  "schemaVersion": 1,
  "shell": {
    "maxRawBytes": 614000,
    "maxGzipBytes": 177000,
    "maxTimeToInteractiveMs": 5000,
    "maxInitialRequests": 8,
    "forbiddenInitialAssetPatterns": [
      "document",
      "epub",
      "pdf",
      "kokoro",
      "transformers",
      "ephone",
      "phonemizer",
      "piper",
      "ort-wasm",
      "lamejs",
      "Signalsmith"
    ]
  },
  "lazyBoundaries": {
    "document-parsers": {
      "patterns": ["document", "epub", "pdf"],
      "maxRawBytes": 3800000,
      "maxGzipBytes": 1100000
    },
    "kokoro-runtime": {
      "patterns": ["kokoro-", "dist-lib"],
      "maxRawBytes": 1700000,
      "maxGzipBytes": 850000
    },
    "multilingual-g2p": {
      "patterns": ["ephone", "phonemizer", "roa-", "all-", "sit-", "jpx-", "en-us-"],
      "maxRawBytes": 46500000,
      "maxGzipBytes": 34500000
    },
    "transformers-runtime": {
      "patterns": ["transformers.web"],
      "maxRawBytes": 1650000,
      "maxGzipBytes": 470000
    },
    "piper-runtime": {
      "patterns": ["piper_plus_wasm"],
      "maxRawBytes": 65000000,
      "maxGzipBytes": 24000000
    },
    "onnx-web-runtime": {
      "patterns": ["ort-wasm"],
      "maxRawBytes": 40000000,
      "maxGzipBytes": 10500000
    },
    "mp3-encoder": {
      "patterns": ["lamejs"],
      "maxRawBytes": 200000,
      "maxGzipBytes": 70000
    },
    "pitch-processor": {
      "patterns": ["SignalsmithStretch"],
      "maxRawBytes": 125000,
      "maxGzipBytes": 55000
    }
  },
  "assetOwnership": {
    "maxAssetRawBytes": 65000000,
    "maxAssetGzipBytes": 23000000,
    "maxUnownedRawBytes": 120000,
    "maxUnownedGzipBytes": 50000,
    "patterns": [
      { "name": "initial-shell", "patterns": ["index-", "theme-boot"] },
      { "name": "shared-runtime", "patterns": ["src-", "rolldown-runtime", "preload-helper", "__vite-browser-external"] },
      { "name": "document-parsers", "patterns": ["document", "epub", "pdf", "readability"] },
      { "name": "kokoro-runtime", "patterns": ["kokoro", "dist-lib"] },
      { "name": "multilingual-g2p", "patterns": ["ephone", "phonemizer", "roa-", "all-", "sit-", "jpx-", "en-us-"] },
      { "name": "transformers-runtime", "patterns": ["transformers.web", "chatterbox", "tts.worker"] },
      { "name": "piper-runtime", "patterns": ["piper_plus"] },
      { "name": "onnx-web-runtime", "patterns": ["ort-"] },
      { "name": "audio-runtime", "patterns": ["lamejs", "SignalsmithStretch", "audio-", "wav", "encode"] },
      { "name": "optional-ui-and-artifacts", "patterns": ["ReaderView", "MiniPlayer", "LibraryPanel", "EpubMapping", "Normalization", "SentenceRetake", "WebGpu", "AudioOutput", "DesktopIntegrations", "LongForm", "Quality", "archive-budget", "audiobook", "backup", "m4b", "media-overlays", "model-cache", "provenance", "queue-sentence", "generation-dispatcher", "text-normalization", "capabilities", "browser"] }
    ]
  },
  "realEngine": {
    "maxTimeToFirstAudioMs": 30000,
    "maxRealTimeFactor": 3
  }
}
